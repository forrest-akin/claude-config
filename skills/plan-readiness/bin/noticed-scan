#!/usr/bin/env python3
"""Ranks the .claude/noticed.md entries a plan must dispose of.

Usage: noticed-scan <plan> [repo]   (repo defaults to the git top level of the current directory)
Prints TSV `class count entry`, highest count first, where count is the entry's commits in the
last year. class is touched-file (the plan names the file), touched-dir (the plan names a file in
its directory) or delete (touched-dir with no commit in the last year).
"""
import os
import re
import subprocess
import sys

ENTRY = re.compile(r"^- ([^\s:]+):\d+ — ")


def git(repo, *args):
    return subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True, check=True).stdout


def year_count(repo, path):
    return len(git(repo, "log", "--since=1.year", "--oneline", "--", path).splitlines())


def rows(plan_text, ledger, repo):
    touched = {token.rstrip(".") for token in re.findall(r"[\w./-]+", plan_text)}
    dirs = {os.path.dirname(token) for token in touched if "/" in token}
    if any(os.path.isfile(os.path.join(repo, token)) for token in touched if "/" not in token):
        dirs.add("")
    found = []
    for line in ledger.splitlines():
        match = ENTRY.match(line)
        if not match:
            continue
        path = match.group(1)
        if path in touched:
            found.append(("touched-file", year_count(repo, path), line[2:]))
        elif os.path.dirname(path) in dirs:
            count = year_count(repo, path)
            found.append(("touched-dir" if count else "delete", count, line[2:]))
    return sorted(found, key=lambda row: -row[1])


def main(argv):
    if len(argv) not in (2, 3):
        print("usage: noticed-scan <plan> [repo]", file=sys.stderr)
        return 2
    plan = argv[1]
    if len(argv) == 3:
        repo = argv[2]
    else:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        if top.returncode != 0:
            print("error: not a git repository", file=sys.stderr)
            return 2
        repo = top.stdout.strip()
    try:
        with open(plan, encoding="utf-8") as f:
            plan_text = f.read()
    except (OSError, UnicodeDecodeError):
        print(f"error: cannot read {plan}", file=sys.stderr)
        return 2
    ledger_path = os.path.join(repo, ".claude", "noticed.md")
    if not os.path.exists(ledger_path):
        return 0
    with open(ledger_path, encoding="utf-8") as f:
        ledger = f.read()
    for cls, count, entry in rows(plan_text, ledger, repo):
        print(f"{cls}\t{count}\t{entry}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
