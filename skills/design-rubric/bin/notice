#!/usr/bin/env python3
"""Appends a dated line to .claude/noticed.md at the git top level, unless the ledger already
holds an entry with the same path (line ignored) and smell.

Usage: notice <path:line> <smell or invariant> <curing move>
"""
import datetime
import os
import pathlib
import re
import subprocess
import sys

HEADING = "# Noticed and left alone\n\n"
USAGE = "usage: notice <path:line> <smell or invariant> <curing move>\n"
LOCATION = re.compile(r"[^\s:]+:\d+")
SEPARATOR = " — "


def path_of(location):
    return location.rsplit(":", 1)[0]


def same_entries(ledger, location, smell):
    """The ledger's `<path:line> — <smell>` keys whose path and smell match, line ignored."""
    keys = [line[2:].split(SEPARATOR)[:2] for line in ledger.splitlines() if line.startswith("- ")]
    return [SEPARATOR.join(key) for key in keys if [path_of(key[0])] + key[1:] == [path_of(location), smell]]


def main(argv):
    if len(argv) != 4 or not LOCATION.fullmatch(argv[1]):
        sys.stderr.write(USAGE)
        return 2
    location, smell, move = argv[1:]
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if top.returncode != 0:
        sys.stderr.write("error: not a git repository\n")
        return 2
    path = os.path.join(top.stdout.strip(), ".claude", "noticed.md")
    new = not os.path.exists(path)
    same = [] if new else same_entries(pathlib.Path(path).read_text(encoding="utf-8"), location, smell)
    if same:
        print(f"already noticed: {same[0]}")
        return 0
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as f:
        if new:
            f.write(HEADING)
        f.write(f"- {location} — {smell} — {move} — {datetime.date.today().isoformat()}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
