#!/usr/bin/env python3
"""Reports functions whose lizard metrics a diff pushed past a threshold or worsened past one.

Usage: health-delta [BASE]   (BASE defaults to HEAD: the working tree against the last commit)
Prints TSV `path:line function smell before after cure`; exits 1 when it prints a row.
"""
import csv
import io
import os
import re
import shutil
import subprocess
import sys
import tempfile

# (lizard --csv -ENS column, threshold, smell, cure)
METRICS = [
    (0, 30, "Large method", "Extract Function"),
    (1, 7, "Complex method", "Decompose Conditional; Replace Conditional with Polymorphism"),
    (11, 2, "Nested complexity", "Replace Nested Conditional with Guard Clauses"),
    (3, 3, "Excess arguments", "Introduce Parameter Object"),
]
NAME, START = 7, 9
ACCEPTED = re.compile(r"smell: .+ — .+ — \d{4}-\d{2}-\d{2}")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def usage_error(base):
    def fails(*args):
        return subprocess.run(["git", *args], capture_output=True).returncode != 0
    if fails("rev-parse", "--show-toplevel"):
        return "not a git repository"
    if fails("rev-parse", "--verify", "--quiet", base + "^{commit}"):
        return f"unknown BASE {base}"
    return None


def touched_files(base):
    changed = git("diff", "--name-only", base).splitlines()
    untracked = git("ls-files", "--others", "--exclude-standard").splitlines()
    return [path for path in changed + untracked if os.path.isfile(path)]


def base_text(base, path):
    result = subprocess.run(["git", "show", f"{base}:{path}"], capture_output=True, text=True)
    return result.stdout if result.returncode == 0 else ""


def find_lizard():
    found = shutil.which("lizard")
    mise = shutil.which("mise") or os.path.expanduser("~/.local/bin/mise")
    if found or not os.access(mise, os.X_OK):
        return found
    result = subprocess.run([mise, "which", "lizard"], capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 and result.stdout.strip() else None


def measure(lizard, text, path):
    """Maps (function name, nth of that name) to its lizard CSV row for `text` analysed as `path`."""
    with tempfile.TemporaryDirectory() as tmp:
        copy = os.path.join(tmp, os.path.basename(path))
        with open(copy, "w", encoding="utf-8") as f:
            f.write(text)
        out = subprocess.run([lizard, "--csv", "-ENS", copy], capture_output=True, text=True).stdout
    rows, seen = {}, {}
    for row in csv.reader(io.StringIO(out)):
        seen[row[NAME]] = seen.get(row[NAME], -1) + 1
        rows[(row[NAME], seen[row[NAME]])] = row
    return rows


def unaccepted(rows, lines):
    """Drops functions whose line above carries `smell: <factor> — <rationale> — <YYYY-MM-DD>`."""
    def above(row):
        start = int(row[START])
        return lines[start - 2] if start >= 2 else ""
    return {key: row for key, row in rows.items() if not ACCEPTED.search(above(row))}


def crossings(row, old):
    """Yields (smell, before, after, cure) per metric now past its threshold and worse than before."""
    for column, threshold, smell, cure in METRICS:
        now, was = int(row[column]), (int(old[column]) if old else None)
        if now > threshold and (was is None or now > was):
            yield smell, "-" if was is None else str(was), str(now), cure


def findings(path, before, after):
    for key, row in after.items():
        for crossing in crossings(row, before.get(key)):
            yield "\t".join([f"{path}:{row[START]}", row[NAME], *crossing])


def analysed_name(path, text):
    """Names an extensionless script by its shebang so lizard picks a parser; None when none fits."""
    if os.path.splitext(path)[1]:
        return path
    shebang = text.split("\n", 1)[0]
    return path + ".py" if shebang.startswith("#!") and "python" in shebang else None


def file_findings(lizard, base, path):
    """Returns the rows for `path`, or None when lizard cannot read it."""
    with open(path, encoding="utf-8") as f:
        text = f.read()
    name = analysed_name(path, text)
    if name is None:
        return None
    after = unaccepted(measure(lizard, text, name), text.splitlines())
    return list(findings(path, measure(lizard, base_text(base, path), name), after))


def report(lizard, base):
    rows, unread = [], []
    for path in touched_files(base):
        try:
            found = file_findings(lizard, base, path)
        except (OSError, UnicodeDecodeError):
            found = None
        if found is None:
            unread.append(path)
        else:
            rows.extend(found)
    for row in rows:
        print(row)
    if unread:
        print("unread:", *unread, sep="\n")
    return 1 if rows else 0


def main(argv):
    base = argv[1] if len(argv) > 1 else "HEAD"
    error = usage_error(base)
    if error:
        sys.stderr.write(f"error: {error}\n")
        return 2
    lizard = find_lizard()
    if lizard is None:
        sys.stderr.write("warning: lizard not found; health-delta skipped\n")
        return 0
    os.chdir(git("rev-parse", "--show-toplevel").strip())
    return report(lizard, base)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
