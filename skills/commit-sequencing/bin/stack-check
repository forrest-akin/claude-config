#!/usr/bin/env python3
"""Usage: stack-check BASE

Prints one TSV row per commit in BASE..HEAD, oldest first: sha, subject, files, changed lines
outside .claude/, changed lines under .claude/, flags. Then a total row of the two line counts.
"""
import re
import subprocess
import sys

OVERSIZE = 300
COLLAPSE_UNDER = 100
PLACEHOLDER = re.compile(r"^((wip|temp|tmp)\b|fixup!|part [0-9])", re.IGNORECASE)


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def commits(base):
    out = git("log", "--reverse", "--no-merges", "--format=%x00%h%x09%s", "--numstat", f"{base}..HEAD")
    for record in out.split("\x00")[1:]:
        header, _, numstat = record.partition("\n")
        sha, subject = header.split("\t", 1)
        rows = [r.split("\t") for r in numstat.splitlines() if r]
        counted = [(int(a) + int(d), path.startswith(".claude/")) for a, d, path in rows if a != "-"]
        changed = sum(n for n, claude in counted if not claude)
        yield sha, subject, len(rows), changed, sum(n for n, claude in counted if claude)


def base_error(base):
    if subprocess.run(["git", "rev-parse", "--git-dir"], capture_output=True).returncode != 0:
        return "not a git repository"
    found = subprocess.run(["git", "rev-parse", "--verify", "--quiet", f"{base}^{{commit}}"], capture_output=True)
    return None if found.returncode == 0 else f"unknown BASE {base}"


def flags(subject, changed):
    found = []
    if changed > OVERSIZE:
        found.append(f">{OVERSIZE}")
    if PLACEHOLDER.match(subject):
        found.append("placeholder")
    return ",".join(found)


def main(argv):
    if len(argv) != 2:
        print("usage: stack-check BASE", file=sys.stderr)
        return 2
    error = base_error(argv[1])
    if error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    stack = list(commits(argv[1]))
    for sha, subject, files, changed, claude in stack:
        print(f"{sha}\t{subject}\t{files}\t{changed}\t{claude}\t{flags(subject, changed)}")
    total = sum(changed for *_, changed, _ in stack)
    claude_total = sum(claude for *_, claude in stack)
    collapse = "\tcollapse?" if len(stack) > 1 and total < COLLAPSE_UNDER else ""
    print(f"total\t{total}\t{claude_total}{collapse}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
